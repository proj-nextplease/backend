# Local backend environment.
# Spring Boot does not automatically load this file.
# Add these values to your IntelliJ run configuration, export them in your shell,
# or set them directly in Railway service variables.

APP_SECURITY_JWT_ENABLED=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

DATABASE_URL=jdbc:postgresql://localhost:5432/nextplease?sslmode=disable
DB_USERNAME=postgres
DB_PASSWORD=postgres

SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_JWKS_URI=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1
